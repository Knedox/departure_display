#pragma once

/* ---------------------------------------------------------------------------
 * Template for main/secrets.h - copy it and fill in the real values:
 *
 *     cp main/secrets.h.example main/secrets.h
 *
 * main/secrets.h is git-ignored, so the credentials below are never committed.
 * The values here are placeholders only and will not connect to anything.
 * ------------------------------------------------------------------------ */

#define WIFI_SSID_VALUE "your-wifi-ssid"
#define WIFI_PASS_VALUE "your-wifi-password"

/* Fallback wall-clock offset used until the first API response supplies the
 * real offset from its ISO timestamps (+0200 = CEST, +0100 = CET). */
#define TIMEZONE_OFFSET_SECONDS (2 * 3600)
